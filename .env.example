# Copy to .env for local testing. On Railway, set these in the
# service's own Variables tab instead -- do not commit a real .env.
#
# Same database as the main verisreports service. Either set
# DATABASE_URL as a single DSN, or the five DB_* vars individually --
# app.py checks DATABASE_URL first, falls back to the individual vars.
DATABASE_URL=

DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# Comma-separated. Origins allowed to open a cross-origin EventSource
# connection to this service -- needed for templates/debate.html once
# it's pointed at this service's own domain instead of verumsignal.com
# itself. Defaults to the production site if unset (see app.py).
ALLOWED_ORIGINS=https://verumsignal.com,https://www.verumsignal.com
